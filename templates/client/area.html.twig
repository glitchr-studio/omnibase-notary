{# One field of practice (Base\Notary\Controller\Client\NotaryController::area). #}
{% extends office_layout() %}

{% block title %}{{ area.name }}{% endblock %}
{% block description %}{{ area.summary }}{% endblock %}

{% block content %}
<article class="of-page no-area">
    <p class="of-back"><a href="{{ path('notary_areas') }}">← {{ 'areas.title'|trans({}, 'notary') }}</a></p>
    <header class="of-page-head">
        <h1>{{ area.name }}</h1>
        {% if area.summary %}<p class="of-lead">{{ area.summary }}</p>{% endif %}
    </header>
    <div class="of-columns">
        <div class="of-prose">
            {% for paragraph in area.paragraphs %}<p>{{ paragraph|nl2br }}</p>{% endfor %}
            <p class="of-actions"><a class="of-button" href="{{ path('office_booking') }}">{{ 'areas.ask'|trans({}, 'notary') }}</a></p>
        </div>
        <aside>
            {% if area.deeds %}
            <h2>{{ 'areas.deeds'|trans({}, 'notary') }}</h2>
            <ul class="no-deeds">{% for deed in area.deeds %}<li>{{ deed }}</li>{% endfor %}</ul>
            {% endif %}
            {% if area.members|length %}
            <h2>{{ 'areas.team'|trans({}, 'notary') }}</h2>
            <ul class="of-list">{% for member in area.members %}{% if member.visible and member.active %}<li><a href="{{ path('office_member', {slug: member.slug}) }}">{{ member.displayName }}</a>{% if member.title %} <span class="of-meta">— {{ member.title }}</span>{% endif %}</li>{% endif %}{% endfor %}</ul>
            {% endif %}
            <h2>{{ 'areas.cost'|trans({}, 'notary') }}</h2>
            <p>{{ 'areas.cost_text'|trans({}, 'notary') }} <a href="{{ path('notary_tariff') }}">{{ 'areas.cost_link'|trans({}, 'notary') }}</a></p>
        </aside>
    </div>
    {% if areas|length > 1 %}
    <nav class="no-others" aria-label="{{ 'areas.others'|trans({}, 'notary') }}">
        <h2>{{ 'areas.others'|trans({}, 'notary') }}</h2>
        <ul>{% for other in areas %}{% if other.id != area.id %}<li><a href="{{ path('notary_area', {slug: other.slug}) }}">{{ other.name }}</a></li>{% endif %}{% endfor %}</ul>
    </nav>
    {% endif %}
</article>
{% endblock %}
